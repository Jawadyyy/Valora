# Discord bot token — https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: server (guild) id for instant slash-command sync while developing.
# Empty = global sync, which can take up to an hour to show up.
DEV_GUILD_ID=

# Free Henrik API key — https://docs.henrikdev.xyz (their Discord → get a key).
# Powers /rank, /crosshair, /featured, /status. Leave empty to disable those.
HENRIK_API_KEY=
